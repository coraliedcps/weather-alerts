# Copier en .env (ignoré par git) et remplir — mêmes valeurs que commute-alerts si vous
# utilisez le même serveur ntfy (mais un topic différent pour séparer les alertes).
NTFY_URL=https://ntfy.example.org
# Nom de canal difficile à deviner (ex. weather-alerts-x7Kp2mQ9...) : sur ntfy.sh il tient lieu de mot de passe.
NTFY_TOPIC=change-me
NTFY_TOKEN=
